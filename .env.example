# Environment Variables Example for EvolveAI

# Server Secret (Cloudflare Workers Secret) - used to encrypt user BYOK API keys
# Minimum 32-character random string. Set via: wrangler secret put ENCRYPTION_SECRET
ENCRYPTION_SECRET=your_super_secret_32_char_key_here_min_length_32

# Session Token Secret - used for session signing and authentication
SESSION_SECRET=your_session_secret_min_32_chars_random_string

# Worker Environment (development | production)
ENVIRONMENT=development

# Web Frontend URL (for CORS validation in Workers)
CLIENT_ORIGIN=http://localhost:5173

# Frontend Environment Variables (apps/web/.env)
VITE_API_URL=http://localhost:8787
